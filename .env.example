# Copy this file to .env and adjust if needed. Never commit the real .env.

# Local dev default: a SQLite file under ./data.
DATABASE_URL=sqlite:///data/tracking.db

# Hosted (Render + Neon Postgres) -- set this as an env var in the Render
# dashboard instead, never in this file:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Used to sign Flask's session cookie. The default below is fine for local
# dev; set a real random value as a Render env var for the hosted app.
SECRET_KEY=dev-secret-key-change-me

